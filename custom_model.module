<?php
use Drupal\user\Entity\User;

function lm_ucname($string) {
  $string = ucwords(strtolower($string));
  foreach (array('-', '\'') as $delimiter) {
    if (strpos($string, $delimiter) !== false) {
      $string = implode($delimiter, array_map('ucfirst', explode($delimiter, $string)));
    }
  }
  return $string;
}


function custom_model_mail($key, &$message, $params) {

  $language = \Drupal::currentUser()->getPreferredLangcode();
  $language = $params['language'] ?? $language;
  $message['langcode'] = $language;

  switch ($key) {


case 'custom_model_proposal_received':

  /* initializing data */
  $proposal_data = \Drupal::database()->select('custom_model_proposal', 'p')
    ->fields('p')
    ->condition('id', $params['custom_model_proposal_received']['result1'])
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  $user = User::load($params['custom_model_proposal_received']['user_id']);

  $message['headers'] = $params['custom_model_proposal_received']['headers'];

  $site_name = \Drupal::config('system.site')->get('name');

  $message['subject'] = t('[@site][Custom Model] Your DWSIM Custom Model proposal has been received', [
    '@site' => $site_name,
  ]);

  $message['body'][] = t('
Dear @name,

We have received your DWSIM Custom Model proposal with the following details:

Full Name: @full_name
Email: @email
University/Institute: @university
Department/Branch: @department
City: @city
State: @state
Country: @country
Project Title: @project_title

Your proposal is under review. You will soon receive an email when same has been approved/disapproved.

Best Wishes,

@site Team,
FOSSEE, IIT Bombay', [
    '@name' => $proposal_data->contributor_name,
    '@full_name' => $proposal_data->name_title . ' ' . $proposal_data->contributor_name,
    '@email' => $user ? $user->getEmail() : '',
    '@university' => $proposal_data->university,
    '@department' => $proposal_data->department,
    '@city' => $proposal_data->city,
    '@state' => $proposal_data->state,
    '@country' => $proposal_data->country,
    '@project_title' => $proposal_data->project_title,
    '@site' => $site_name,
  ]);

  break;


case 'custom_model_proposal_approved':

  $proposal_data = \Drupal::database()->select('custom_model_proposal', 'p')
    ->fields('p')
    ->condition('id', $params['proposal_id']) // ✅ FIXED
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  $user_data = \Drupal\user\Entity\User::load($params['user_id']); // ✅ FIXED

  $site_name = \Drupal::config('system.site')->get('name');

  $message['subject'] = t('[@site][Custom Model] Your DWSIM Custom Model proposal has been approved', [
    '@site' => $site_name,
  ]);

  $message['body'][] = t('
Dear @name,

Your DWSIM Custom Model proposal with the following details has been approved:

Full Name: @full_name
Email: @email
University/Institute: @university
Department/Branch: @department
City: @city
State: @state
Country: @country
Project Title: @project_title


You can upload your abstract and the completed simulation at: @url

Best Wishes,
@site Team', [
    '@name' => $proposal_data->contributor_name,
    '@project_title' => $proposal_data->project_title,
    '@url' => 'http://dwsim.fossee.in/custom-model/abstract-code',
    '@site' => $site_name,
  ]);

  // ✅ Add headers HERE (correct place)
  $config = \Drupal::config('custom_model.settings');

  $message['headers']['From'] = $config->get('custom_model_from_email');
  $message['headers']['Cc'] = $config->get('custom_model_cc_emails');
  $message['headers']['Bcc'] = $config->get('custom_model_emails');

  break;

case 'custom_model_proposal_disapproved':

  /* initializing data */
  $proposal_data = \Drupal::database()->select('custom_model_proposal', 'p')
    ->fields('p')
    ->condition('id', $params['custom_model_proposal_disapproved']['proposal_id'])
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  $user_data = User::load($params['custom_model_proposal_disapproved']['user_id']);

  $message['headers'] = $params['custom_model_proposal_disapproved']['headers'];

  $site_name = \Drupal::config('system.site')->get('name');

  $message['subject'] = t('[@site][Custom Model] Your DWSIM Custom Model proposal has been disapproved', [
    '@site' => $site_name,
  ]);

  $message['body'][] = t('
Dear @name,

We regret to inform you that your DWSIM Custom Model proposal with following details have been disapproved:

Full Name: @full_name
Email: @email
University/Institute: @university
Department/Branch: @department
City: @city
State: @state
Country: @country
Project Guide: @guide_name
Project Guide Email: @guide_email
Project Title: @project_title

Reason for rejection: @reason

You are welcome to submit a new proposal.

Best Wishes,

@site Team,
FOSSEE, IIT Bombay', [
    '@name' => $proposal_data->contributor_name,
    '@full_name' => $proposal_data->name_title . ' ' . $proposal_data->contributor_name,
    '@email' => $user_data ? $user_data->getEmail() : '',
    '@university' => $proposal_data->university,
    '@department' => $proposal_data->department,
    '@city' => $proposal_data->city,
    '@state' => $proposal_data->state,
    '@country' => $proposal_data->country,
    '@guide_name' => $project_guide_name ?? '',
    '@guide_email' => $project_guide_email_id ?? '',
    '@project_title' => $proposal_data->project_title,
    '@reason' => $proposal_data->dissapproval_reason,
    '@site' => $site_name,
  ]);

  break;


case 'custom_model_proposal_completed':

  /* initializing data */
  $proposal_data = \Drupal::database()->select('custom_model_proposal', 'p')
    ->fields('p')
    ->condition('id', $params['custom_model_proposal_completed']['proposal_id'])
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  $user_data = User::load($params['custom_model_proposal_completed']['user_id']);

  $message['headers'] = $params['custom_model_proposal_completed']['headers'];

  $site_name = \Drupal::config('system.site')->get('name');

  $message['subject'] = t('[@site][Custom Model] Your DWSIM Custom Model proposal has been completed', [
    '@site' => $site_name,
  ]);

  $message['body'][] = t('
Dear @name,

Your DWSIM Custom Model and abstract on the following process have been completed successfully.

Full Name: @full_name
Email: @email
University/Institute: @university
Department/Branch: @department
City: @city
State: @state
Country: @country
Project Title: @project_title

Best Wishes,

@site Team,
FOSSEE, IIT Bombay', [
    '@name' => $proposal_data->contributor_name,
    '@full_name' => $proposal_data->name_title . ' ' . $proposal_data->contributor_name,
    '@email' => $user_data ? $user_data->getEmail() : '',
    '@university' => $proposal_data->university,
    '@department' => $proposal_data->department,
    '@city' => $proposal_data->city,
    '@state' => $proposal_data->state,
    '@country' => $proposal_data->country,
    '@project_title' => $proposal_data->project_title,
    '@site' => $site_name,
  ]);

  break;


case 'custom_model_proposal_deleted':

  /* initializing data */
  $proposal_data = \Drupal::database()->select('custom_model_proposal', 'p')
    ->fields('p')
    ->condition('id', $params['custom_model_proposal_deleted']['proposal_id'])
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  $user_data = User::load($params['custom_model_proposal_deleted']['user_id']);

  $message['headers'] = $params['custom_model_proposal_deleted']['headers'];

  $site_name = \Drupal::config('system.site')->get('name');

  $message['subject'] = t('[@site][Custom Model] Your DWSIM Custom Model proposal has been deleted', [
    '@site' => $site_name,
  ]);

  $message['body'][] = t('
Dear @name,

Your DWSIM Custom Model proposal with the following details has been deleted :

Full Name: @full_name
Email: @email
University/Institute: @university
Department/Branch: @department
City: @city
State: @state
Country: @country
Project Title: @project_title

You can propose a new DWSIM Custom Model.

Best Wishes,

@site Team,
FOSSEE, IIT Bombay', [
    '@name' => $proposal_data->contributor_name,
    '@full_name' => $proposal_data->name_title . ' ' . $proposal_data->contributor_name,
    '@email' => $user_data ? $user_data->getEmail() : '',
    '@university' => $proposal_data->university,
    '@department' => $proposal_data->department,
    '@city' => $proposal_data->city,
    '@state' => $proposal_data->state,
    '@country' => $proposal_data->country,
    '@project_title' => $proposal_data->project_title,
    '@site' => $site_name,
  ]);

  break;



case 'abstract_uploaded':

  $proposal_data = \Drupal::database()->select('custom_model_proposal', 'p')
    ->fields('p')
    ->condition('id', $params['proposal_id']) // ✅ FIXED
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  $user = User::load($params['user_id']); // ✅ FIXED

  $site_name = \Drupal::config('system.site')->get('name');

  $message['subject'] = t('[@site][Custom Model] You have uploaded DWSIM Custom Model project files', [
    '@site' => $site_name,
  ]);

  $message['body'][] = t(
'Dear @name,

You have uploaded the following Abstract and Project files:

Project Title: @project_title

The abstract and project files are under review. You will be notified when it has been approved.

Best Wishes,

@site Team,
FOSSEE, IIT Bombay',
  [
    '@name' => $proposal_data->contributor_name,
    '@project_title' => $proposal_data->project_title,
    '@site' => $site_name,
  ]);

  // ✅ Headers MUST be set here
  $config = \Drupal::config('custom_model.settings');
  $message['headers']['From'] = $config->get('custom_model_from_email');
  $message['headers']['Cc'] = $config->get('custom_model_cc_emails');
  $message['headers']['Bcc'] = $config->get('custom_model_emails');

  break;
  
      case 'abstract_approval':

      $proposal_id = (int) $params['abstract_approval']['proposal_id'];

      $proposal_data = \Drupal::database()->select('custom_model_proposal', 'cmp')
        ->fields('cmp')
        ->condition('id', $proposal_id)
        ->range(0, 1)
        ->execute()
        ->fetchObject();

      $user = \Drupal\user\Entity\User::load($params['abstract_approval']['user_id']);
      $site_name = \Drupal::config('system.site')->get('name');

      // Headers
      $message['headers'] = $params['abstract_approval']['headers'];

      // Subject
      $message['subject'] = t('[@site][Custom Model] Your uploaded Custom Model has been approved', [
        '@site' => $site_name,
      ]);

      // Body (IMPORTANT: use [] to avoid empty mail)
      $message['body'][] = t('
Dear @name,

Your uploaded abstract for the Custom Model has been approved:

Title of Custom Model: @title

Best Wishes,

@site Team,
FOSSEE, IIT Bombay', [
        '@name' => $proposal_data ? $proposal_data->contributor_name : 'User',
        '@title' => $proposal_data ? $proposal_data->project_title : 'N/A',
        '@site' => $site_name,
      ]);

    break;

  case 'standard':

  $message['subject'] = $params['standard']['subject'];

  // Ensure body is always an array
  $message['body'] = is_array($params['standard']['body'])
    ? $params['standard']['body']
    : [$params['standard']['body']];

  $message['headers'] = $params['standard']['headers'];

  break;
  }
}
   